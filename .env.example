# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/clinic
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/clinic

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === OpenRouter (LLM Gateway) ===
OPENROUTER_API_KEY=your-openrouter-api-key
BOOKING_MODEL=google/gemini-2.0-flash-001
DOCTOR_MODEL=openai/gpt-4o
IMAGING_MODEL=google/gemini-2.0-flash-001

# === Speech-to-Text ===
GOOGLE_CLOUD_STT_CREDENTIALS=path/to/credentials.json
OPENAI_API_KEY=your-openai-api-key

# === Tavily Search ===
TAVILY_API_KEY=your-tavily-api-key

# === LangSmith Observability ===
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=clinic-system

# === Clinic Auth (MVP) ===
CLINIC_SECRET_PATH=my-clinic-secret
CLINIC_CONFIG_TOKEN=your-secure-token-here

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
